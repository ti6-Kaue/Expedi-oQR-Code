<?xml version="1.0" encoding="utf-8"?>
<!-- Temas Android usados antes do Flutter desenhar a primeira tela.
     Observacao: normalmente nao precisa mexer aqui. -->
<resources>
    <!-- Tema aplicado a janela Android durante a inicializacao com o modo escuro desativado. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Exibe a tela de abertura na Activity. Ela e removida automaticamente
             quando o mecanismo Flutter desenha o primeiro quadro. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Tema aplicado a janela Android assim que o processo e iniciado.
         Ele determina a cor da janela durante a inicializacao da interface
         Flutter e tambem permanece atras dela durante a execucao.

         Este tema e utilizado a partir da versao 2 da integracao Android do Flutter. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
