# Arquivos ignorados pelo Git.
# Observacao: caches, builds, logs e APKs gerados nao precisam ir para o repositorio.
# Arquivos diversos
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
.api-server.*
.api-validate.*
.apk-server.*
.flutter-web-server.*

# Arquivos relacionados ao IntelliJ
*.iml
*.ipr
*.iws
.idea/

# A pasta .vscode contem configuracoes de inicializacao e tarefas do VS Code.
# Caso queira versiona-la, remova o comentario da linha abaixo.
#.vscode/

# Arquivos relacionados ao Flutter, Dart e Pub
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/dist/
/ARQUIVOS_GERADOS/
/api/node_modules/
/configuracao.env

# Arquivos relacionados a simbolizacao
app.*.symbols

# Arquivos relacionados a ofuscacao
app.*.map.json

# O Android Studio armazena artefatos de compilacao nestas pastas
/android/app/debug
/android/app/profile
/android/app/release
